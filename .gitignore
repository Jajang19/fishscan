# FishScan .gitignore - "allow list" style.
# Everything is ignored by default; only the files the deployed app needs
# are allowed back in below. This keeps OUT of GitHub, for example:
#   data/raw/            (dataset images)
#   .venv/               (local Python environment)
#   models/experiments/  models/baseline/  models/quick_test/  checkpoints/
#   reports/baseline/, and most of reports/experiments/
#   *_examples.csv       (contain local file paths)
#   data/not_fish_eye/, data/real_fish_eye/ (your own photos stay private)
#   reports/eye_check_details.csv (file names of your photos)

*

# --- project files ---
!.gitignore
!README.md
!CLAUDE.md
!requirements.txt
!app.py

# --- training code and the Colab notebook (backed up since 2026-11-23,
#     after a laptop failure lost scripts that were never pushed) ---
!scripts/
!scripts/*.py
!notebooks/
!notebooks/*.ipynb

# --- the fixed train/val/test split (paths only, no images) ---
!data/
!data/ffe_split.csv

# --- app code ---
!src/
!src/*.py

# --- Streamlit settings ---
!.streamlit/
!.streamlit/config.toml

# --- look and feel: stylesheet, logo, favicon, sample eye photo ---
!assets/
!assets/style.css
!assets/logo.png
!assets/favicon.png
!assets/sample_eye.jpg

# --- final models only (2 models + their metadata) ---
!models/
!models/species_model.keras
!models/species_meta.joblib
!models/freshness_model.keras
!models/freshness_meta.joblib
# fish-eye check (training features + cut-off), needed by the online app
!models/eye_check.npz

# --- reports used by the Model Performance page ---
!reports/
!reports/*_summary.json
!reports/*_classification_report.csv
!reports/*_calibration.csv
!reports/*_calibration.png
!reports/*_confusion_matrix.png
!reports/*_training_curves.png
!reports/*_examples.png
!reports/eye_check_results.json
# small tables that explain how the final freshness model was chosen
!reports/experiments/
!reports/experiments/comparison_val.csv
!reports/experiments/temperature_scaling_half2.csv

# never commit Python caches, even inside allowed folders
__pycache__/
*.pyc
